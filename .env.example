# deploy.sh가 SITE_ADDRESS, CADDY_TLS, COMPOSE_FILE, NPM_NETWORK를 채워 준다. 나머지는 필요하면 바꾼다.
ADMIN_PIN=0000
DEMO_MODE=1
EVENTS_TOKEN=
HTTP_PORT=80
HTTPS_PORT=443

# ./deploy.sh npm 에서 Nginx Proxy Manager에 Proxy Host를 자동으로 만들 때 쓴다
NPM_EMAIL=
NPM_PASSWORD=
NPM_URL=http://127.0.0.1:81
KIOSK_DOMAIN=
LE_EMAIL=
